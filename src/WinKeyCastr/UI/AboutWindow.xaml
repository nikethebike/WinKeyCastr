<Window x:Class="WinKeyCastr.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WinKeyCastr.Localization"
        Title="{l:Tr About_Title}"
        Width="300"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ThemeMode="System">
    <StackPanel>
        <Image Source="/Assets/KeyCastr-512.png" Width="220" Height="220" Margin="0,16,0,8"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Separator Margin="0,4" />
        <StackPanel Margin="20,8,20,20">
            <TextBlock Text="WinKeyCastr" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Text="Version" Opacity="0.7" Margin="0,2,0,10" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7">
                <Run Text="{l:Tr About_Port}" /><LineBreak />
                KeyCastr Copyright © 2009-2026 Stephen Deken, Andrew Kitchen, and contributors.
            </TextBlock>
        </StackPanel>
    </StackPanel>
</Window>
